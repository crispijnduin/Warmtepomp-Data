# Dagelijkse export naar CSV, zodat de data ook buiten SQLite beschikbaar is.
[Unit]
Description=Warmtepomp dagelijkse export
After=warmtepomp.service

[Service]
Type=oneshot
User=warmtepomp
Group=warmtepomp
EnvironmentFile=/etc/warmtepomp.env
Environment=WARMTEPOMP_DB_PATH=/var/lib/warmtepomp/warmtepomp.sqlite
Environment=WARMTEPOMP_EXPORT_DIR=/var/lib/warmtepomp/export
ExecStart=/opt/warmtepomp/bin/warmtepomp export --what all --resample 5min
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/warmtepomp
